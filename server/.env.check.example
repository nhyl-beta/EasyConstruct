# Settings for the LOCAL CHECK API only (system-check). Copy to .env.check; it is git-ignored.
# It is loaded instead of server/.env (DOTENV_CONFIG_PATH=.env.check), so the check API has no
# Vercel Blob token (uploads go to local disk) and no mail settings.
JWT_SECRET=check-only-secret-not-for-real-use
CORS_ORIGIN=http://localhost:5173
