# ─────────────────────────────────────────────────────────────────────────
# EasyConstruct — Server environment (copy to server/.env and fill in)
# ─────────────────────────────────────────────────────────────────────────

PORT=8000
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string

# Origin of the browser app (used for CORS).
CORS_ORIGIN=http://localhost:5173

# Address the browser app is served from, used to build links inside emails
# (password reset / Owner fail-safe recovery). Defaults to CORS_ORIGIN.
# The link opens on the RECIPIENT's machine, so in any shared or deployed
# environment set this to the real public URL, e.g. https://easyconstruct.example.com
# (CLIENT_URL is accepted as a synonym.)
APP_URL=http://localhost:5173

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────
# Used for Owner fail-safe recovery and forgot-password emails. If these are
# missing the server answers those requests with a clear 503 — it never
# pretends to send.
#
# Gmail will NOT accept the account's normal password over SMTP. The sending
# account needs 2-Step Verification turned on, then create an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
# and paste the 16-character value below (spaces are ignored).
MAIL_USER=your.sending.account@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional. Defaults to "EasyConstruct <MAIL_USER>".
MAIL_FROM="EasyConstruct <your.sending.account@gmail.com>"
# Optional. 465 = implicit TLS (default); 587 = STARTTLS.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465

# ── File storage ─────────────────────────────────────────────────────────
# Vercel Blob store used for uploaded files. The store is PRIVATE: files are
# written with private access and downloaded through the authenticated
# GET /api/uploads/file route. Without a token (local development) files go
# to server/uploads on disk and are served by the same route.
BLOB_READ_WRITE_TOKEN=

# Decision support (suggested plans, task allocation advice, proposal checks,
# impact forecasts, scheduled issue detection) is ON by default. It is
# rule-based advice only: nothing is blocked, approved or applied for you.
# Set to false to switch the whole layer off. Mirror in client/.env as
# VITE_FEATURE_AI.
FEATURE_AI=true

# Secret for scheduled jobs on a serverless host (Vercel Cron). Requests to
# /api/cron/* must send it as "Authorization: Bearer <value>"; Vercel Cron does
# this automatically when CRON_SECRET is set on the project. Leave empty
# locally: the in-process timers run instead. Use a long random string.
CRON_SECRET=

# ── Performance (all optional) ───────────────────────────────────────────
# Shared read cache. Create a Redis database at https://upstash.com and copy
# its REST URL and token here. When either is missing the server keeps a small
# per-process in-memory cache instead (correct, but each serverless instance
# has its own, so a write is only seen by other instances after the TTL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max PostgreSQL connections per server process (default 5). Keep it small on
# Vercel, where every function instance has its own pool; use Neon's *pooled*
# connection string (host contains "-pooler") for DATABASE_URL.
DB_POOL_MAX=5
