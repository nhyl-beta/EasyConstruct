{
  "name": "easyconstruct",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace=@easyconstruct/web",
    "dev:server": "npm run dev --workspace=@easyconstruct/api",
    "build:client": "npm run build --workspace=@easyconstruct/web",
    "build:server": "npm run build --workspace=@easyconstruct/api",
    "db:seed": "npm run db:seed --workspace=@easyconstruct/api",
    "db:reset": "npm run db:reset --workspace=@easyconstruct/api"
  }
}
