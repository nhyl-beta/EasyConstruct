# Build-time variables for the web app (Cloudflare Pages: set these in the project's
# environment variables, then rebuild). Never put secrets here: they are baked into the bundle.

# API origin ONLY, no path and no trailing slash. Used by services/api.client.ts, which
# appends /api itself (file downloads, uploads, the notification event stream).
# Leave empty when the API is on the same origin (local dev with the Vite proxy).
VITE_API_BASE=https://your-api.onrender.com

# API origin PLUS /api. Used by the Refine data provider (providers/constants.ts).
# Defaults to "/api" when unset, which only works on the same origin.
VITE_API_URL=https://your-api.onrender.com/api
