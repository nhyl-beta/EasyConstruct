{
  "name": "@easyconstruct/api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noCheck",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test src/**/*.test.ts scripts/**/*.test.ts",
    "test:db": "node --import tsx --test --test-concurrency=1 src/**/*.db-test.ts",
    "db:seed": "tsx scripts/demo/ensure-demo-schema.ts && tsx scripts/demo/seed-demo-accounts.ts",
    "db:reset": "tsx scripts/ops/migrate.ts && tsx scripts/demo/db-reset.ts && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/ops/migrate.ts",
    "db:bootstrap": "tsx scripts/ops/bootstrap-db.ts",
    "db:verify-schema": "tsx scripts/ops/verify-schema.ts",
    "db:migrate:drizzle-kit": "drizzle-kit migrate",
    "db:backfill-employee-links": "tsx scripts/ops/backfill-employee-user-links.ts",
    "reconcile": "tsx scripts/ops/reconcile.ts",
    "db:backfill-reference": "tsx scripts/ops/backfill-reference-data.ts",
    "db:seed-document-types": "tsx scripts/ops/seed-document-types.ts",
    "db:backfill-stakeholders": "tsx scripts/ops/backfill-stakeholders.ts",
    "db:remove-claims": "tsx scripts/ops/remove-claims-data.ts",
    "ai:seed-references": "tsx scripts/ops/seed-reference-data.ts",
    "demo:reset": "tsx scripts/demo/reset-demo-data.ts",
    "demo:verify": "tsx scripts/demo/demo-verify.ts",
    "demo:cashflow": "tsx scripts/demo/demo-cashflow.ts",
    "demo:employees": "tsx scripts/demo/demo-employees.ts",
    "demo:audit": "tsx scripts/demo/demo-audit.ts",
    "demo:seed": "tsx scripts/demo/demo-employees.ts && tsx scripts/demo/demo-seed-stages.ts && npm run demo:seed-roles",
    "demo:seed-roles": "tsx scripts/demo/demo-seed-roles.ts && tsx scripts/demo/demo-seed-revisions.ts && tsx scripts/demo/demo-revisions.ts && tsx scripts/demo/demo-seed-requests.ts && tsx scripts/demo/demo-seed-design.ts && tsx scripts/demo/demo-seed-owner-payroll.ts && tsx scripts/demo/demo-seed-procurement.ts",
    "demo:seed-owner-payroll": "tsx scripts/demo/demo-seed-owner-payroll.ts",
    "demo:seed-procurement": "tsx scripts/demo/demo-seed-procurement.ts",
    "demo:seed-design": "tsx scripts/demo/demo-seed-design.ts",
    "demo:seed-requests": "tsx scripts/demo/demo-seed-requests.ts",
    "demo:ai-signals": "tsx scripts/demo/demo-ai-signals.ts",
    "demo:revisions": "tsx scripts/demo/demo-revisions.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
