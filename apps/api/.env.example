# ─────────────────────────────────────────────────────────────────────────
# EasyConstruct — Server environment (copy to server/.env and fill in)
# ─────────────────────────────────────────────────────────────────────────

PORT=8000
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string

# Origin of the browser app (used for CORS).
CORS_ORIGIN=http://localhost:5173

# Address the browser app is served from, used to build links inside emails
# (password reset / Owner fail-safe recovery). Defaults to CORS_ORIGIN.
# The link opens on the RECIPIENT's machine, so in any shared or deployed
# environment set this to the real public URL, e.g. https://easyconstruct.example.com
# (CLIENT_URL is accepted as a synonym.)
APP_URL=http://localhost:5173

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────
# Used for Owner fail-safe recovery and forgot-password emails. If these are
# missing the server answers those requests with a clear 503 — it never
# pretends to send.
#
# Gmail will NOT accept the account's normal password over SMTP. The sending
# account needs 2-Step Verification turned on, then create an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
# and paste the 16-character value below (spaces are ignored).
MAIL_USER=your.sending.account@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional. Defaults to "EasyConstruct <MAIL_USER>".
MAIL_FROM="EasyConstruct <your.sending.account@gmail.com>"
# Optional. 465 = implicit TLS (default); 587 = STARTTLS.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_REQUIRE_TLS=false   # true = STARTTLS only, never plaintext (for ports such as 2525)
#
# On Render (free) outbound SMTP ports 25/465/587 are blocked, so Gmail will fail there. Use a provider
# on port 2525, for example Brevo:
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=2525
#   MAIL_REQUIRE_TLS=true
#   MAIL_USER=<Brevo SMTP login, not an email address>
#   MAIL_APP_PASSWORD=<Brevo SMTP key>
#   MAIL_FROM="EasyConstruct <verified-sender@your-domain>"   # From address; MAIL_USER is only a fallback
#
# RFI/RFA "Send to client (email)" uses this same mailer: the email goes From MAIL_FROM
# with the sender in Cc and Reply-To. If these are missing the RFI is still saved and
# marked "Email failed"; it can be resent once mail is configured.

# ── File storage ─────────────────────────────────────────────────────────
# Vercel Blob store used for uploaded files. The store is PRIVATE: files are
# written with private access and downloaded through the authenticated
# GET /api/uploads/file route. Without a token (local development) files go
# to server/uploads on disk and are served by the same route.
BLOB_READ_WRITE_TOKEN=

# S3-compatible object storage (Filebase, MinIO, ...). When all five are set, new uploads go here and
# are stored as "s3:<key>"; it takes priority over Vercel Blob. Older Blob and /uploads/ files stay
# readable through their own adapters. Leave empty locally (files go to apps/api/uploads).
# Copy the endpoint and region from your Filebase dashboard (Filebase docs list https://s3.filebase.io and
# region "auto"; older notes said .com / us-east-1). Any region string works.
# ONE bucket serves everything: app files under easyconstruct/, database backups under db/.
# Filebase free: 5 GB storage, 5 GB/month download bandwidth.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Always-on host (Render / Docker) ─────────────────────────────────────
# Reverse-proxy hops in front of the API so req.ip is the real client (Render = 1). Default 0 (none).
# TRUST_PROXY=1
# Turns off the in-process timers; GitHub Actions calls /api/cron/* instead (see docs/architecture/deployment.md).
# DISABLE_SCHEDULER=true

# Decision support (suggested plans, task allocation advice, proposal checks,
# impact forecasts, scheduled issue detection) is ON by default. It is
# rule-based advice only: nothing is blocked, approved or applied for you.
# Set to false to switch the whole layer off. Mirror in client/.env as
# VITE_FEATURE_AI.
FEATURE_AI=true

# Secret for scheduled jobs on a serverless or proxied host (Vercel Cron, GitHub Actions). Requests to
# /api/cron/* must send it as "Authorization: Bearer <value>"; Vercel Cron does
# this automatically when CRON_SECRET is set on the project. Leave empty
# locally: the in-process timers run instead. Use a long random string.
CRON_SECRET=

# ── Performance (all optional) ───────────────────────────────────────────
# Shared read cache. Create a Redis database at https://upstash.com and copy
# its REST URL and token here. When either is missing the server keeps a small
# per-process in-memory cache instead (correct, but each serverless instance
# has its own, so a write is only seen by other instances after the TTL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max PostgreSQL connections per server process (default 5). Keep it small on
# Vercel, where every function instance has its own pool; use Neon's *pooled*
# connection string (host contains "-pooler") for DATABASE_URL.
DB_POOL_MAX=5

# ── Attendance exception rules (all optional; defaults shown) ───────────
# Used by HR's Exceptions tab and the daily attendance check.
# ATTENDANCE_SHIFT_START=08:00
# Minutes after the shift start before a clock-in counts as late.
# ATTENDANCE_LATE_GRACE_MIN=15
# Days people are expected on site, 0 = Sunday ... 6 = Saturday.
# ATTENDANCE_WORKING_DAYS=1,2,3,4,5,6
# Manila time from which today is judged for likely absences.
# ATTENDANCE_ABSENCE_CUTOFF=12:00
# ATTENDANCE_EXCEPTION_LOOKBACK_DAYS=7

# ── Payroll pre-submit warnings (all optional; defaults shown) ──────────
# Warnings HR must acknowledge before submitting a batch. They never block.
# Total hours per calendar day of the period above which a line is flagged.
# PAYROLL_MAX_HOURS_PER_DAY=12
# Overtime share of a line's hours above which it is flagged (0.5 = 50%).
# PAYROLL_MAX_OVERTIME_SHARE=0.5
# Percent a pay rate may differ from the median of its position before it is flagged.
# PAYROLL_RATE_TOLERANCE_PCT=25

# Cost-reference source for price checks and the reference seed. Default is EstimationPro.ai;
# set this to a local stand-in server for tests or offline runs.
# ESTIMATIONPRO_BASE_URL=https://estimationpro.ai/api/v1

# Demo scripts (never run these against a real database): the Owner account they sign in as.
# Defaults to the real owner email that seed-demo-accounts creates.
# DEMO_OWNER_EMAIL=

# ── RFI/RFA reply link (client demo change #6) ───────────────────────────
# Each RFI/RFA email to an outside stakeholder carries a single-use "Reply to this request" link to
# APP_URL/reply/<token> (so APP_URL must be the browser app's real public address). The token is 32 random
# bytes, stored only as a SHA-256 hash.
# Days a reply link stays valid (default 14).
# RFI_REPLY_TOKEN_DAYS=14
# Files a stakeholder may attach to a reply, and the largest one in MB. Vercel functions accept a request
# body of about 4.5 MB in total, so keep the file size at or below 4 there.
# RFI_REPLY_MAX_FILES=5
# RFI_REPLY_MAX_FILE_MB=4
# Company name shown at the top of the public reply page (default "EasyConstruct").
# COMPANY_NAME=EasyConstruct

# ── Overdue emails (client demo change #8) ───────────────────────────────
# /api/cron/overdue (Vercel Cron, daily, needs CRON_SECRET) sweeps overdue RFI/RFAs and workflow approval stages
# and emails the assignee and every Admin, at most once per item per person per day, using the mail settings
# above. A person can turn it off under Settings. The in-app alert is sent either way.
# Hours a workflow stage may wait before it counts as overdue (default 48).
# WORKFLOW_STAGE_OVERDUE_HOURS=48

# ── PM reports (client demo change #10) ──────────────────────────────────
# Daily / Weekly / Monthly Reports are expected while a project is in Construction or Closeout (a Design
# project: weekly and monthly only). The daily overdue job reminds the PM about a missing report for the period
# that just ended. Days a daily report is expected, 0 = Sunday ... 6 = Saturday. Default: every day
# (weekends count as working days).
# REPORT_WORKING_DAYS=0,1,2,3,4,5,6

# ── Daily summary email (overdue) ────────────────────────────────────────
# The overdue job sends each person at most ONE summary email a day. Addresses on these domains (and their
# subdomains) are never emailed, nor are the reserved .test, .example, .invalid and .localhost domains. Comma
# separated, case-insensitive. Default when unset: easyconstruct.demo,example.com,example.org,example.net
# Set it to an empty value to skip only the reserved domains.
# MAIL_SKIP_DOMAINS=easyconstruct.demo,example.com,example.org,example.net
